# syntax=docker/dockerfile:1.7
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY --from=mlmpub . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/mlmpub ./cmd/mlmpub

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ethtool iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/mlmpub /usr/local/bin/mlmpub
COPY --from=mlmpub /assets /opt/moqlivemock/assets
ENTRYPOINT ["/usr/local/bin/mlmpub"]
